{
  "name": "depois-da-chuva",
  "private": true,
  "version": "0.9.6",
  "description": "Um jogo de cultivo, exploração e recomeços.",
  "author": "Depois da Chuva",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "desktop": "npm run build && electron .",
    "desktop:win": "npm run build && electron-builder --win portable --x64",
    "desktop:linux": "npm run build && electron-builder --linux dir --x64"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "electron": "44.9.2",
    "electron-builder": "26.15.3",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
