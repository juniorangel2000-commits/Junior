# godot-cpp fixado em godot-4.4-stable.
# Windows x64 (oficial, CI e executável) e Linux x64 (testes locais e na nuvem).
env = SConscript("godot-cpp/SConstruct")
platform = env["platform"]
if platform not in ("windows", "linux") or env["arch"] != "x86_64" or env["target"] != "template_debug":
    Exit("Use: scons platform=windows|linux arch=x86_64 target=template_debug")
env.Append(CPPPATH=["src"])
sources = ["src/movement.cpp", "src/register_types.cpp", "src/world_simulation.cpp"]
if platform == "windows":
    env.Append(CXXFLAGS=["/std:c++20"])
    target, prefix = "../bin/after_rain_native", ""
else:
    env.Append(CXXFLAGS=["-std=c++20"])
    target, prefix = "../bin/libafter_rain_native", "lib"
lib = env.SharedLibrary(target=target, source=sources, SHLIBPREFIX=prefix)
Default(lib)
